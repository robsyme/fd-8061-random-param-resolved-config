params {
    outdir  = 'results'
    run_tag = UUID.randomUUID().toString().take(8)
}

process {
    publishDir = [ path: { "${params.outdir}/${params.run_tag}/${task.process.toLowerCase()}" }, mode: 'copy' ]
}

timeline {
    enabled = true
    file    = "${params.outdir}/${params.run_tag}/pipeline_info/timeline.html"
}
